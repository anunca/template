NGINX_VERSION=nginx:1.30.0-alpine
PHP_VERSION=8.3.31
# DOCKERFILE=Dockerfile
# PHP_IMAGE=php:${PHP_VERSION}-fpm
DOCKERFILE=Dockerfile.alpine
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine
COMPOSER_VERSION==2.9.7

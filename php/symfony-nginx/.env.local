NGINX_VERSION=nginx:1.31.4-alpine
PHP_VERSION=8.5.10
# DOCKERFILE=Dockerfile
# PHP_IMAGE=php:${PHP_VERSION}-fpm
DOCKERFILE=Dockerfile.alpine
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine
COMPOSER_VERSION=2.10.2
COMPOSER_IMAGE=composer:${COMPOSER_VERSION}

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=symfony-nginx
IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}

DOTNET_SDK_VERSION=mcr.microsoft.com/dotnet/sdk:6.0-alpine
DOTNET_RUNTIME_VERSION=mcr.microsoft.com/dotnet/runtime:6.0-alpine
MSSQL_VERSION=2022-latest
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:${MSSQL_VERSION}

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=dotnet
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}
